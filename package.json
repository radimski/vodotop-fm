{
  "name": "vodotop-fm",
  "private": true,
  "description": "VODOTOP FM s.r.o. — static HTML generated from build/",
  "scripts": {
    "html": "node build/build.js",
    "css": "npx tailwindcss -c build/tailwind.config.js -i build/src.css -o site/styles.css --minify",
    "inline": "node build/inline-css.js",
    "build": "npm run html && npm run css && npm run inline",
    "photos": "node build/photos.js && node build/responsive.js",
    "fonts": "node build/fonts.js",
    "export": "node build/export.js",
    "serve": "node build/serve.js"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  }
}
