<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="lib" />
          <add segment="data" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".jsonl" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".dist" allowed="false" />
          <add fileExtension=".htaccess" allowed="false" />
        </fileExtensions>
        <denyUrlSequences>
          <add sequence="config.php" />
          <add sequence="config.example.php" />
        </denyUrlSequences>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Robots-Tag" />
        <add name="X-Robots-Tag" value="noindex, nofollow" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; sandbox" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
